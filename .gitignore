# --- Datasets (machine-local, huge) ---
# Anchored: only the repo-root dataset dir. An unanchored "data/" would also
# hide the source package lib/train/data/ (loader.py, sampler.py, ...).
/data/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.ipynb_checkpoints/

# --- Virtual envs ---
.venv/
venv/
env/
.conda/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Model weights & exports ---
*.pth
*.pth.tar
*.pt
*.ckpt
*.onnx
*.engine
*.trt

# --- LMDB stores (lasot_lmdb etc.) ---
*.lmdb
*.lmdb/

# --- Training artifacts ---
# generated train split for the custom LaSOT dataset (regenerated by tools/coco2lasot.py)
lib/train/data_specs/lasot_custom_train_split.txt
checkpoints/
snapshots/
tensorboard/
runs/
events.out.tfevents.*
*.log
logs/

# --- Tracking / eval outputs ---
results/
output/
predictions/
